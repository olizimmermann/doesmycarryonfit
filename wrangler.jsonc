// Cloudflare Workers config: pure static site from ./web, no Worker code.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doesmycarryonfit",
  "compatibility_date": "2026-11-01",

  // Writes web/version.js (footer version) before every dev/deploy run.
  "build": { "command": "python3 scripts/build.py" },

  "assets": {
    "directory": "./web",
    // "/" serves index.html; /privacy.html redirects (307) to /privacy.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "workers_dev": true,
  "preview_urls": false

  // Cut-over to the real domain: uncomment AFTER testing on *.workers.dev and
  // after deleting the old A record pointing at the VPS, then set workers_dev false.
  // , "routes": [{ "pattern": "doesmycarryon.fit", "custom_domain": true }]
}
